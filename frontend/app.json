{
  "expo": {
    "name": "NeuroFlow",
    "slug": "neuroflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#6C63FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neuroflow.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6C63FF"
      },
      "package": "com.neuroflow.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-speech"
    ]
  }
}
